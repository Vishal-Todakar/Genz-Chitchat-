# ===================================
# Genz chitchat — Environment Variables
# ===================================
# Copy this to .env and fill in your values

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
CHAT_RATE_LIMIT_WINDOW_MS=10000
CHAT_RATE_LIMIT_MAX=10

# Moderation
REPORTS_BEFORE_BAN=5
BAN_DURATION_HOURS=24

# Ads
AD_INTERSTITIAL_SKIP_COUNT=3

# ===================================
# Email / OTP Delivery Service
# ===================================
# Default provider: 'gmail' (requires a 16-character Google App Password)
# Alternative providers: 'smtp' | 'resend' | 'brevo' | 'sendgrid'
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=Genz chitchat <noreply@genzchitchat.com>

# Swappable Providers (Optional alternatives)
# RESEND_API_KEY=re_123456789
# BREVO_API_KEY=xkeysib-123456789
# SENDGRID_API_KEY=SG.123456789

# --- Phase 3+ ---
# DATABASE_URL=postgresql://user:password@localhost:5432/genz_chitchat
# REDIS_URL=redis://localhost:6379
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxx
# JWT_SECRET=your-super-secret-jwt-key
# ADSENSE_CLIENT_ID=ca-pub-xxx
